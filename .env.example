# ==================================================
# Global LLM configuration
# ==================================================

# Supported values: ollama, openai, gemini
CAREER_MATCH_LLM_PROVIDER=ollama

# Example models:
# Ollama: gemma3:4b
# Gemini: gemini-2.5-flash
# OpenAI: set an appropriate supported model
CAREER_MATCH_LLM_MODEL=gemma3:4b

CAREER_MATCH_LLM_TIMEOUT_SECONDS=1200


# ==================================================
# LLM provider credentials
# ==================================================

# Required only when CAREER_MATCH_LLM_PROVIDER=openai
CAREER_MATCH_OPENAI_API_KEY=

# Required only when CAREER_MATCH_LLM_PROVIDER=gemini
CAREER_MATCH_GEMINI_API_KEY=


# ==================================================
# Ollama
# ==================================================

# Used only when CAREER_MATCH_LLM_PROVIDER=ollama
CAREER_MATCH_OLLAMA_BASE_URL=http://127.0.0.1:11434


# ==================================================
# Candidate profile / assessment limits
# ==================================================

CAREER_MATCH_MAX_CV_TEXT_CHARACTERS=30000
CAREER_MATCH_MAX_HIRING_AGENT_REPORT_BYTES=1048576


# ==================================================
# Job provider
# ==================================================

CAREER_MATCH_JOB_PROVIDER=arbeitnow
CAREER_MATCH_ARBEITNOW_BASE_URL=https://www.arbeitnow.com
CAREER_MATCH_ARBEITNOW_TIMEOUT_SECONDS=300
CAREER_MATCH_ARBEITNOW_MAX_PAGES=3
CAREER_MATCH_HTTP_USER_AGENT=career-match-agent/0.1.0


# ==================================================
# Embedding provider
# ==================================================

CAREER_MATCH_EMBEDDING_PROVIDER=sentence_transformers
CAREER_MATCH_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CAREER_MATCH_EMBEDDING_DEVICE=cpu
CAREER_MATCH_EMBEDDING_BATCH_SIZE=16


# ==================================================
# Job evaluation
# ==================================================

CAREER_MATCH_MAXIMUM_EVALUATION_JOBS=5
