CAREER_MATCH_OLLAMA_BASE_URL=http://127.0.0.1:11434
CAREER_MATCH_OLLAMA_MODEL=gemma3:4b
CAREER_MATCH_OLLAMA_TIMEOUT_SECONDS=600
CAREER_MATCH_MAX_CV_TEXT_CHARACTERS=30000
CAREER_MATCH_MAX_HIRING_AGENT_REPORT_BYTES=1048576

CAREER_MATCH_JOB_PROVIDER=arbeitnow
CAREER_MATCH_ARBEITNOW_BASE_URL=https://www.arbeitnow.com
CAREER_MATCH_ARBEITNOW_TIMEOUT_SECONDS=20
CAREER_MATCH_ARBEITNOW_MAX_PAGES=3
CAREER_MATCH_HTTP_USER_AGENT=career-match-agent/0.1.0

embedding_provider: str = "sentence_transformers"
embedding_model: str = (sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2")
embedding_device: str = "cpu"
embedding_batch_size: int = Field(default=16, ge=1, le=128)

job_evaluation_model: str = "gemma3:4b"
job_evaluation_timeout_seconds: float = Field(default=300.0, gt=0)
maximum_evaluation_jobs: int = Field(default=5, ge=1, le=20)
